{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=TekusProviderServices;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "tekus.provider-services",
    "Audience": "tekus.provider-services.web",
    "SigningKey": "CHANGE_ME_IN_PRODUCTION_USE_AT_LEAST_32_BYTES_SIGNING_KEY_0123456789",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "CountryCatalog": {
    "BaseUrl": "https://restcountries.com/v3.1",
    "CacheDurationMinutes": 1440,
    "Fields": "name,cca2,cca3,region,currencies",
    "UseExternalService": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tekus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Tekus.ProviderServices.Api"
    }
  },
  "AllowedHosts": "*"
}
