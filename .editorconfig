# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,ts,css,html,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,vb}]
# ---- .NET naming / style conventions (enforced at build) ----
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = false:suggestion

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = readonly,static,const

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_diagnostic.CA1031.severity = none   # catch general exception types (used in middleware)
dotnet_diagnostic.CA1062.severity = none   # null checks handled by nullable reference types
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait not needed in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source generators (optional)
dotnet_diagnostic.IDE0055.severity = none  # formatting handled by the editor
